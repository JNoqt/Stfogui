local library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Consistt/Ui/main/UnLeaked"))()

local username = library:GetUsername()
local owners = { Nezuurr = true, EfdoRB = true }

library.rank = owners[username] and "owner" or "member"

local gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
library.title = "Nezy | " .. gameName

local Wm = library:Watermark("Nezy UI | v" .. library.version .. " | " .. username .. " | rank: " .. library.rank)
local FpsWm = Wm:AddWatermark("fps: " .. library.fps)
coroutine.wrap(function()
    while wait(0.75) do
        FpsWm:Text("fps: " .. library.fps)
    end
end)()

local Notif = library:InitNotifications()
Notif:Notify("Made by Nezy", 3, "success")

library:Introduction()
wait(1)
local Init = library:Init()

local EventTab = Init:NewTab("Current Event")
local EventSection = EventTab:NewSection("Event")
